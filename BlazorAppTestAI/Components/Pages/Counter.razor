@page "/counter"
@rendermode InteractiveServer

<PageTitle>Counter</PageTitle>

<h1>Counter</h1>

<p role="status">Current count: @currentCount</p>

<div class="mb-3">
    <label class="form-label" for="step">Step size</label>
    <input id="step" class="form-control" type="number" min="1" @bind="Step" />
</div>

<div class="btn-group mb-4" role="group" aria-label="Counter controls">
    <button class="btn btn-outline-primary" @onclick="DecrementCount">- @Step</button>
    <button class="btn btn-primary" @onclick="IncrementCount">+ @Step</button>
    <button class="btn btn-outline-secondary" @onclick="ResetCount" disabled="@(currentCount == 0)">Reset</button>
</div>

<h2 class="h4">Recent activity</h2>
@if (history.Count == 0)
{
    <p class="text-muted">No changes yet.</p>
}
else
{
    <ul class="list-group">
        @foreach (var entry in history)
        {
            <li class="list-group-item">@entry</li>
        }
    </ul>
}

@code {
    private const int MaximumHistoryEntries = 5;
    private readonly List<string> history = [];
    private int currentCount;
    private int step = 1;

    private int Step
    {
        get => step;
        set => step = Math.Max(1, value);
    }

    private void IncrementCount()
    {
        ChangeCount(Step);
    }

    private void DecrementCount()
    {
        ChangeCount(-Step);
    }

    private void ResetCount()
    {
        var previousCount = currentCount;
        currentCount = 0;
        AddHistory($"Reset from {previousCount} to 0");
    }

    private void ChangeCount(int amount)
    {
        currentCount += amount;
        Console.WriteLine();
        AddHistory($"{(amount > 0 ? "Increased" : "Decreased")} by {Math.Abs(amount)}: {currentCount}");
    }

    private void AddHistory(string entry)
    {
        history.Insert(0, entry);

        if (history.Count > MaximumHistoryEntries)
        {
            history.RemoveAt(MaximumHistoryEntries);
        }
    }

}