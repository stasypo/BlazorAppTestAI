@page "/divider"
@rendermode InteractiveServer

<PageTitle>Divider</PageTitle>

<h1>Divider</h1>

<p role="status">Current value: @currentValue</p>

<div class="mb-3">
    <label class="form-label" for="divisor">Divisor</label>
    <input id="divisor" class="form-control" type="number" min="1" @bind="Divisor" />
</div>

<div class="btn-group mb-4" role="group" aria-label="Divider controls">
    <button class="btn btn-primary" @onclick="DivideValue">÷ @Divisor</button>
    <button class="btn btn-outline-secondary" @onclick="ResetValue" disabled="@(currentValue == 1)">Reset</button>
</div>

<h2 class="h4">Recent activity</h2>
@if (history.Count == 0)
{
    <p class="text-muted">No changes yet.</p>
}
else
{
    <ul class="list-group">
        @foreach (var entry in history)
        {
            <li class="list-group-item">@entry</li>
        }
    </ul>
}

@code {
    private const int MaximumHistoryEntries = 5;
    private readonly List<string> history = [];
    private double currentValue = 1;
    private int divisor = 2;

    private int Divisor
    {
        get => divisor;
        set => divisor = Math.Max(1, value);
    }

    private void DivideValue()
    {
        var previousValue = currentValue;
        currentValue /= Divisor;
        AddHistory($"Divided {previousValue} by {Divisor}: {currentValue}");
    }

    private void ResetValue()
    {
        var previousValue = currentValue;
        currentValue = 1;
        AddHistory($"Reset from {previousValue} to 1");
    }

    private void AddHistory(string entry)
    {
        history.Insert(0, entry);

        if (history.Count > MaximumHistoryEntries)
        {
            history.RemoveAt(MaximumHistoryEntries);
        }
    }

}
