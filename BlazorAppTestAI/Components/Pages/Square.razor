@page "/square"
@rendermode InteractiveServer

<PageTitle>Square</PageTitle>

<h1>Square</h1>

<p role="status">Current value: @currentValue</p>

<div class="btn-group mb-4" role="group" aria-label="Square controls">
    <button class="btn btn-primary" @onclick="SquareValue">x²</button>
    <button class="btn btn-outline-secondary" @onclick="ResetValue" disabled="@(currentValue == 1)">Reset</button>
</div>

<h2 class="h4">Recent activity</h2>
@if (history.Count == 0)
{
    <p class="text-muted">No changes yet.</p>
}
else
{
    <ul class="list-group">
        @foreach (var entry in history)
        {
            <li class="list-group-item">@entry</li>
        }
    </ul>
}

@code {
    private const int MaximumHistoryEntries = 5;
    private readonly List<string> history = [];
    private long currentValue = 1;

    private void SquareValue()
    {
        var previousValue = currentValue;
        currentValue *= currentValue;
        AddHistory($"Squared {previousValue}: {currentValue}");
    }

    private void ResetValue()
    {
        var previousValue = currentValue;
        currentValue = 1;
        AddHistory($"Reset from {previousValue} to 1");
    }

    private void AddHistory(string entry)
    {
        history.Insert(0, entry);

        if (history.Count > MaximumHistoryEntries)
        {
            history.RemoveAt(MaximumHistoryEntries);
        }
    }

}
